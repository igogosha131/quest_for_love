  <label class="pcheck"><input type="checkbox" id="showFilter">звук кассеты</label>
  <label class="pcheck"><input type="checkbox" id="showPlay">кнопка play</label>
  <button id="previewBtn" class="ppreview">предпросмотр</button>
</div>

<button id="exitPreview" class="exitbtn">← к настройкам</button>

<main class="page">
