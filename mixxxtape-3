<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Страница голоса — демо</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Marck+Script&family=Manrope:wght@400;500;700&family=Amatic+SC:wght@700&display=swap" rel="stylesheet">
<!-- если CDN не откроется, замени на https://unpkg.com/wavesurfer.js@7 -->
<script src="https://unpkg.com/wavesurfer.js@7/dist/wavesurfer.min.js"></script>
<style>
  *{box-sizing:border-box;margin:0}
  body{min-height:100vh;display:flex;flex-direction:column;align-items:center;
       background:var(--bg);color:var(--ink);font-family:Manrope,system-ui,sans-serif;
       transition:background .4s,color .4s}

  /* ---------- ТЕМЫ ---------- */
  body[data-theme="minimal"]{--bg:#ffffff;--ink:#141414;--accent:#141414;--wave:#14141422;--glowc:transparent;--head:'Caveat';--panel:#ffffffee;--cbody:#1c1c1c;--label:#f7f3ea;--labelink:#141414;--tape:#654a30}
  body[data-theme="warm"]   {--bg:#f3e9d7;--ink:#54402e;--accent:#8a5a33;--wave:#8a5a3333;--glowc:#ffd9a055;--head:'Marck Script';--panel:#f3e9d7ee;--cbody:#5b4632;--label:#fbf6ec;--labelink:#54402e;--tape:#7a5230}
  body[data-theme="night"]  {--bg:#0f1418;--ink:#eaf7f5;--accent:#3ee6cf;--wave:#eaf7f522;--glowc:#3ee6cf44;--head:'Caveat';--panel:#0f1418ee;--cbody:#080b0d;--label:#1d2a30;--labelink:#eaf7f5;--tape:#8a6a4a}
  body[data-theme="retro"]  {--bg:#e8dcc3;--ink:#3d3226;--accent:#b4552d;--wave:#b4552d33;--glowc:transparent;--head:'Amatic SC';--panel:#e8dcc3ee;--cbody:#7a4a2b;--label:#f4ead6;--labelink:#3d3226;--tape:#654a30}
  body[data-theme="fest"]   {--bg:#fbf7f0;--ink:#2b2b2b;--accent:#c29a5b;--wave:#c29a5b33;--glowc:#ffd98855;--head:'Marck Script';--panel:#fbf7f0ee;--cbody:#2b2b2b;--label:#fffdf8;--labelink:#2b2b2b;--tape:#8a6a45}

  /* ---------- панель демо ---------- */
  .panel{position:fixed;top:0;left:0;right:0;z-index:10;display:flex;flex-wrap:wrap;gap:6px;
         justify-content:center;align-items:center;padding:8px 10px;font-size:12px;background:var(--panel);backdrop-filter:blur(8px)}
  .panel button{border:1px solid var(--accent);background:none;color:var(--ink);border-radius:999px;padding:4px 10px;cursor:pointer;font-size:12px}
  .panel button.active{background:var(--accent);color:var(--bg)}
  .ppreview{background:var(--accent);color:var(--bg);border:none;font-weight:700}
  .pfile{border:1px dashed var(--accent);border-radius:999px;padding:4px 10px;cursor:pointer}
  .pfile input{display:none}
  .pcheck{display:flex;gap:4px;align-items:center}

  /* ---------- предпросмотр ---------- */
  .exitbtn{position:fixed;bottom:16px;left:50%;transform:translateX(-50%);z-index:20;display:none;
           border:1px solid var(--accent);background:var(--panel);color:var(--ink);border-radius:999px;
           padding:8px 14px;font-size:12px;cursor:pointer;backdrop-filter:blur(8px)}
  body.preview .panel{display:none}
  body.preview .exitbtn{display:block}
  body.preview .page{padding-top:48px}

  /* ---------- страница ---------- */
  .page{width:min(430px,100%);padding:84px 24px 40px;text-align:center}
  .topicon{width:30px;height:30px;opacity:.7;margin-bottom:14px}
  .names{font-family:var(--head),cursive;font-size:36px;font-weight:500;line-height:1.15}
  .date{margin-top:6px;font-size:14px;letter-spacing:.12em;opacity:.7}
  [contenteditable]:focus{outline:1.5px dashed var(--accent);outline-offset:5px;border-radius:4px}

  /* ---------- кассета ---------- */
  .cassette{margin:26px auto 4px;cursor:pointer;user-select:none}
  .cassette svg{width:min(320px,100%);filter:drop-shadow(0 12px 32px var(--glowc));transition:filter .4s}
  .cassette rect,.cassette circle,.cassette path,.cassette text,.cassette line{transition:fill .4s,stroke .4s}
  .reel{transform-box:fill-box;transform-origin:center;animation:spin 1.8s linear infinite;animation-play-state:paused}
  body.playing .reel{animation-play-state:running}
  body.fast .reel{animation-duration:.22s}
  @keyframes spin{to{transform:rotate(360deg)}}

  /* ---------- плеер ---------- */
  #wave{margin:22px auto 4px;width:100%;transition:max-width .35s ease}
  body.has-cassette #wave{max-width:260px}
  .transport{display:flex;justify-content:center;align-items:center;gap:16px;margin:14px 0 8px}
  .tbtn{width:46px;height:46px;border-radius:50%;border:1.5px solid var(--accent);background:transparent;color:var(--ink);
        display:grid;place-items:center;cursor:pointer;touch-action:none;user-select:none;-webkit-user-select:none;transition:transform .12s}
  .tbtn:active{transform:scale(.9)}
  .play{width:64px;height:64px;border-radius:50%;border:none;cursor:pointer;
        display:grid;place-items:center;background:var(--accent);color:var(--bg);
        box-shadow:0 10px 28px var(--glowc);transition:transform .15s;visibility:hidden}
  body.show-play .play{visibility:visible}
  .play:active{transform:scale(.94)}
  .i-pause{display:none}
  body.playing .i-pause{display:block}
  body.playing .i-play{display:none}
  .time{font-size:12px;opacity:.6;letter-spacing:.08em}
  .msg{margin:26px auto 0;max-width:320px;font-family:var(--head),cursive;font-size:22px;line-height:1.4}
  footer{margin-top:34px;font-size:12px;opacity:.5;letter-spacing:.06em}
</style>
</head>
<body data-theme="minimal">

<div class="panel">
  <span>демо · тема:</span>
  <button data-theme="minimal" class="active">минимал</button>
  <button data-theme="warm">тёплый</button>
