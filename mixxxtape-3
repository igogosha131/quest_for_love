      <path d="M62.5 197.1L76.5 162.4H249L263.5 197.5" stroke="#fff" stroke-opacity=".15" stroke-width=".7" fill="none"/>
      <g fill="#727272" opacity=".3">
        <rect x="122" y="173" width="8" height="8" rx="1"/>
