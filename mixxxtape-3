  <div class="date" data-field="date" contenteditable spellcheck="false">12 октября 2024</div>

  <!-- КАССЕТА -->
  <div class="cassette" id="cassette" title="нажми — играет">
    <svg viewBox="0 0 320 200" xmlns="http://www.w3.org/2000/svg">
      <rect x="2.5" y="2.5" width="315" height="195" rx="15.5" fill="var(--cbody)" stroke="#000"/>
      <rect x="10" y="10" width="300" height="180" rx="12" fill="none" stroke="#fff" stroke-opacity=".15"/>
      <rect x="28" y="22" width="268" height="130" rx="10" fill="var(--label)"/>
      <text x="44" y="47" fill="var(--labelink)" font-family="Manrope" font-size="12" letter-spacing="4" font-weight="700">SIDE A</text>
      <text x="276" y="47" text-anchor="end" fill="var(--labelink)" opacity=".55" font-family="Manrope" font-size="10">mixtape.ru</text>
      <line x1="44" y1="56" x2="276" y2="56" stroke="var(--labelink)" opacity=".25"/>
      <rect x="75" y="63" width="173" height="67" rx="10" fill="#181512" stroke="#000" stroke-opacity=".4"/>
      <path id="tapePath" d="" stroke="var(--tape)" stroke-width="4" fill="none" stroke-linecap="round"/>
      <circle id="packL" cx="125" cy="97" r="28" fill="var(--tape)" stroke="#000" stroke-opacity=".4"/>
      <g class="reel">
