  </div>

  <div id="wave"></div>

  <div class="transport">
    <button id="rew" class="tbtn" aria-label="перемотка назад">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19 7l-7 5 7 5zM12 7l-7 5 7 5z"/></svg>
    </button>
