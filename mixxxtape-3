</main>

<script>
  const $ = s => document.querySelector(s);
  const body = document.body;
  let ws = null, dur = 0;

  const fmt = t => { t = Math.round(t || 0); return Math.floor(t/60) + ':' + String(t%60).padStart(2,'0'); };
  const themeVars = () => {
    const cs = getComputedStyle(body);
    return { wave: cs.getPropertyValue('--wave').trim(), accent: cs.getPropertyValue('--accent').trim() };
  };

  /* ---------- 1. тексты: свои примеры на тему, пользовательский фиксируется ---------- */
  const DEFAULTS = {
    minimal: { names:'Маша и Илья',        date:'12 октября 2024',        msg:'С годовщиной! Это песня нашего первого танца ♥' },
    warm:    { names:'Мама и папа',        date:'1 июня 1998',            msg:'Двадцать пять лет вместе — и это только начало…' },
    night:   { names:'Кирилл и Вера',      date:'ночь, 14 августа 2025',  msg:'Твой голос — мой любимый трек' },
    retro:   { names:'Семья Ковалёвых',    date:'лето 1987',              msg:'Из семейного архива, с любовью' },
    fest:    { names:'Аня и Максим',       date:'день свадьбы, 07.07.2026', msg:'Песня, с которой у нас всё началось' },
  };
  const custom = { names:null, date:null, msg:null };
  document.querySelectorAll('[contenteditable]').forEach(el => {
    el.addEventListener('input', () => { custom[el.dataset.field] = el.textContent; });
  });
  function applyTexts(theme){
    document.querySelectorAll('[contenteditable]').forEach(el => {
      const f = el.dataset.field;
      el.textContent = custom[f] !== null ? custom[f] : DEFAULTS[theme][f];
    });
  }

  /* ---------- лента: прогресс + вобблинг ---------- */
  const R_MIN = 12, R_MAX = 28, CY = 97, LX = 125, RX = 195;
  let curP = 0, playing = false, phase = 0;
  function tapeD(p, w){
    p = Math.max(0, Math.min(1, p || 0));
    const rl = R_MIN + (R_MAX - R_MIN) * (1 - p);
    const rr = R_MIN + (R_MAX - R_MIN) * p;
    $('#packL').setAttribute('r', rl.toFixed(2));
    $('#packR').setAttribute('r', rr.toFixed(2));
    return `M ${LX} ${(CY + rl - 1).toFixed(2)} C 145 ${(128 + w).toFixed(2)}, 175 ${(128 - w * .7).toFixed(2)}, ${RX} ${(CY + rr - 1).toFixed(2)}`;
  }
  const drawTape = w => $('#tapePath').setAttribute('d', tapeD(curP, w || 0));
  drawTape(0);
  (function loop(){
    if (playing){ phase += 0.11; drawTape(Math.sin(phase) * 1.2 + Math.sin(phase * 2.3) * 0.5); }
    requestAnimationFrame(loop);
  })();

  /* ---------- 2. звук кассеты (Web Audio) ---------- */
  let actx = null, graph = null;
  const ensureCtx = () => { actx = actx || new (window.AudioContext || window.webkitAudioContext)(); if (actx.state === 'suspended') actx.resume(); return actx; };
  const noiseBuffer = ctx => { const b = ctx.createBuffer(1, ctx.sampleRate * 2, ctx.sampleRate); const d = b.getChannelData(0); for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1; return b; };
  const satCurve = () => { const n = 1024, c = new Float32Array(n); for (let i = 0; i < n; i++){ const x = i / n * 2 - 1; c[i] = Math.tanh(1.6 * x) / Math.tanh(1.6); } return c; };
  const filterOn = () => $('#showFilter').checked;

  function stopGraph(){
    if (!graph) return;
    [...graph.oscs, graph.hiss].forEach(n => { try { n.stop(); } catch(e){} });
    graph = null;
  }
  function buildGraph(el){
    const ctx = ensureCtx(); stopGraph();
    const src  = ctx.createMediaElementSource(el);
    const dry  = ctx.createGain(); dry.gain.value = 1;
    const wet  = ctx.createGain(); wet.gain.value = 0;
    const hp = ctx.createBiquadFilter(); hp.type='highpass'; hp.frequency.value=70;
    const lp = ctx.createBiquadFilter(); lp.type='lowpass';  lp.frequency.value=9000; lp.Q.value=.6;
    const pk = ctx.createBiquadFilter(); pk.type='peaking';  pk.frequency.value=2400; pk.gain.value=2.5; pk.Q.value=.9;
    const sh = ctx.createWaveShaper(); sh.curve = satCurve(); sh.oversample='2x';
    const dly = ctx.createDelay(0.05); dly.delayTime.value=0.012;
    const lfoW = ctx.createOscillator(); lfoW.frequency.value=0.8; const gW=ctx.createGain(); gW.gain.value=0.0035; lfoW.connect(gW).connect(dly.delayTime); lfoW.start();
    const lfoF = ctx.createOscillator(); lfoF.frequency.value=5.3; const gF=ctx.createGain(); gF.gain.value=0.0012; lfoF.connect(gF).connect(dly.delayTime); lfoF.start();
    src.connect(dry).connect(ctx.destination);
    src.connect(hp); hp.connect(lp); lp.connect(pk); pk.connect(sh); sh.connect(dly); dly.connect(wet); wet.connect(ctx.destination);
    const hiss = ctx.createBufferSource(); hiss.buffer = noiseBuffer(ctx); hiss.loop = true;
    const hf = ctx.createBiquadFilter(); hf.type='highpass'; hf.frequency.value=3000;
    const hg = ctx.createGain(); hg.gain.value=0;
    hiss.connect(hf); hf.connect(hg); hg.connect(ctx.destination); hiss.start();
    graph = { el, dry, wet, hg, oscs:[lfoW, lfoF] };
    applyFilterState();
  }
  function applyFilterState(){
    if (!graph) return;
    const on = filterOn(), t = actx.currentTime;
    graph.wet.gain.setTargetAtTime(on ? 1 : 0, t, .05);
    graph.dry.gain.setTargetAtTime(on ? 0 : 1, t, .05);
    graph.hg.gain.setTargetAtTime(on && playing ? 0.014 : 0, t, .08);
  }
  $('#showFilter').onchange = () => {
    if (filterOn() && ws && !graph) buildGraph(ws.getMediaElement());
    ensureCtx(); applyFilterState();
  };

  /* ---------- 3. перемотка с визгом ленты ---------- */
  let whine = null, stepInt = null, wasPlaying = false;
  function startWhine(dir){
    const ctx = ensureCtx(); stopWhine();
    const src = ctx.createBufferSource(); src.buffer = noiseBuffer(ctx); src.loop = true;
    const bp  = ctx.createBiquadFilter(); bp.type='bandpass'; bp.frequency.value = dir > 0 ? 1100 : 850; bp.Q.value=1.4;
    const bp2 = ctx.createBiquadFilter(); bp2.type='bandpass'; bp2.frequency.value = dir > 0 ? 2600 : 2100; bp2.Q.value=2;
    const g = ctx.createGain(); g.gain.value=0;
    const lfo = ctx.createOscillator(); lfo.frequency.value = dir > 0 ? 13 : 9;
    const lg = ctx.createGain(); lg.gain.value=140; lfo.connect(lg).connect(bp.frequency); lfo.start();
    src.connect(bp).connect(g); src.connect(bp2).connect(g); g.connect(ctx.destination);
    g.gain.setTargetAtTime(0.05, ctx.currentTime, .03);
    src.start(); whine = { src, g, lfo };
  }
  function stopWhine(){
    if (!whine) return;
    const { src, g, lfo } = whine;
    g.gain.setTargetAtTime(0, actx.currentTime, .04);
    setTimeout(() => { try { src.stop(); lfo.stop(); } catch(e){} }, 250);
    whine = null;
  }
  function holdSeek(dir){
    if (!ws) return;
    const el = ws.getMediaElement();
    wasPlaying = !el.paused;
    startWhine(dir);
    body.classList.add('fast');
    if (dir > 0){ el.playbackRate = 4; el.play(); }
    else { if (!el.paused) el.pause(); stepInt = setInterval(() => { el.currentTime = Math.max(0, el.currentTime - 1.2); }, 90); }
  }
  function endSeek(dir){
    if (!ws) return;
    const el = ws.getMediaElement();
    stopWhine(); body.classList.remove('fast');
    if (dir > 0){ el.playbackRate = 1; if (!wasPlaying) el.pause(); }
    else { clearInterval(stepInt); stepInt = null; if (wasPlaying) el.play(); }
  }
  [['#rew', -1], ['#ff', 1]].forEach(([sel, dir]) => {
    const b = $(sel);
    b.addEventListener('pointerdown', e => { e.preventDefault(); holdSeek(dir); });
    ['pointerup','pointerleave','pointercancel'].forEach(ev => b.addEventListener(ev, () => endSeek(dir)));
    b.addEventListener('contextmenu', e => e.preventDefault());
  });

  /* ---------- wavesurfer ---------- */
  function makeWs(url){
    if (ws) ws.destroy();
    stopGraph();
    dur = 0; curP = 0; drawTape(0);
    const t = themeVars();
    ws = WaveSurfer.create({
      container:'#wave', url, height:76,
      barWidth:2, barGap:2, barRadius:2, cursorWidth:1, normalize:true,
      waveColor:t.wave, progressColor:t.accent,
    });
    if (filterOn()) buildGraph(ws.getMediaElement());
    ws.on('play',  () => { playing = true;  body.classList.add('playing'); applyFilterState(); });
    ws.on('pause', () => { playing = false; body.classList.remove('playing'); drawTape(0); applyFilterState(); });
    ws.on('finish',() => { playing = false; body.classList.remove('playing'); drawTape(0); applyFilterState(); });
    ws.on('decode', d => { dur = d; $('#tot').textContent = fmt(d); });
    const onTime = t => { $('#cur').textContent = fmt(t); if (dur > 0){ curP = t / dur; if (!playing) drawTape(0); } };
    ws.on('timeupdate', onTime);
    ws.on('seeking',    onTime);
  }

  const toggle = () => ws ? ws.playPause() : $('#file').click();
  $('#play').onclick = toggle;
  $('#cassette').onclick = toggle;
  $('#file').onchange = e => { const f = e.target.files[0]; if (f) makeWs(URL.createObjectURL(f)); };

  /* темы */
  document.querySelectorAll('[data-theme]').forEach(b => b.onclick = () => {
    body.dataset.theme = b.dataset.theme;
    document.querySelectorAll('[data-theme]').forEach(x => x.classList.toggle('active', x === b));
    applyTexts(b.dataset.theme);
    if (ws) { const t = themeVars(); ws.setOptions({ waveColor:t.wave, progressColor:t.accent }); }
  });

  /* кассета / кнопка play */
  function applyPlayVis(){ body.classList.toggle('show-play', $('#showPlay').checked); }
  function setCassette(on){
    $('#cassette').style.display = on ? '' : 'none';
    body.classList.toggle('has-cassette', on);
    if (!on && !$('#showPlay').checked) $('#showPlay').checked = true; // защита: без кассеты нужна кнопка
    applyPlayVis();
  }
  $('#showCassette').onchange = e => setCassette(e.target.checked);
  $('#showPlay').onchange = applyPlayVis;
  setCassette(true);

  /* предпросмотр */
  function setPreview(on){
    body.classList.toggle('preview', on);
    document.querySelectorAll('[contenteditable]').forEach(el => el.contentEditable = on ? 'false' : 'true');
  }
  $('#previewBtn').onclick  = () => setPreview(true);
  $('#exitPreview').onclick = () => setPreview(false);
</script>
</body>
</html>
